# Local configuration example. Do not put real secrets in this file.

# CSDN rule document. Defaults to D:\czj note\CSDN帖子抓取规则.md when unset.
CSDN_RULE_DOC_PATH=D:\czj note\CSDN帖子抓取规则.md

# Optional date override for older CSDN crawler utilities.
CSDN_START_DATE=2026-08-16
CSDN_END_DATE=2026-08-17

# Feishu/Lark is authorized through local lark-cli.cmd login.
# Do not store app secrets, user tokens, cookies, or passwords here.
CSDN_LARK_BASE_DOMAIN=https://your-domain.feishu.cn
CSDN_LARK_BASE_TOKEN=your_base_token
CSDN_LARK_TABLE_ID=your_table_id
CSDN_LARK_VIEW_ID=your_view_id
